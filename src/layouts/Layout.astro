---
import '../styles/global.css';
import { locales, localeLabels, isRTL, useT, localePath, type Locale } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const tr = useT(locale);
const rtl = isRTL(locale);
const dir = rtl ? 'rtl' : 'ltr';

const services = [
  { label: tr.services.s01.title, href: localePath(locale, '/pricing/brand-identity') },
  { label: tr.services.s02.title, href: localePath(locale, '/pricing/ai-video') },
  { label: tr.services.s03.title, href: localePath(locale, '/pricing/social-media') },
  { label: tr.services.s04.title, href: localePath(locale, '/pricing/3d-modeling') },
];
---

<!doctype html>
<html lang={locale} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description ?? tr.siteDesc} />
  <title>{title ?? tr.siteTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  {locale === 'ar' && (
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  )}
        <!-- Meta Pixel Code -->
<script>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '1066036422940230');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=1066036422940230&ev=PageView&noscript=1"
/></noscript>
<!-- End Meta Pixel Code -->
</head>
<body class={rtl ? 'rtl' : 'ltr'}>

  <!-- NAV -->
  <header id="site-nav">
    <div class="container nav-inner">
      <a href={localePath(locale, '/')} class="logo">
        <img src="/logo.svg" alt="Mh-Studio-logo" />
      </a>

    <button
     class="burger"
     id="burger"
     type="button"
     aria-label="Toggle menu"
     aria-expanded="false"
     aria-controls="nav-links"
    >
        <span></span><span></span><span></span>
      </button>

      <nav class="nav-links" id="nav-links">
        <a href={localePath(locale, '/#services')}>{tr.nav.services}</a>
        <a href={localePath(locale, '/#work')}>{tr.nav.work}</a>
        <a href={localePath(locale, '/pricing/brand-identity')}>{tr.nav.pricing}</a>
        <a href={localePath(locale, '/#about')}>{tr.nav.about}</a>

        <!-- Language switcher -->
        <div class="lang-switcher">
          {locales.map(l => (
            <a
              href={`/${l}/`}
              class={`lang-btn ${l === locale ? 'lang-active' : ''}`}
              lang={l}
            >
              {localeLabels[l]}
            </a>
          ))}
        </div>

        <a href={localePath(locale, '/#contact')} class="nav-cta">{tr.nav.cta}</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-brand">
                    <a href={localePath(locale, '/')} class="logo">
                        <img src="/logo.svg" alt="Mh-Studio-logo" />

                    </a>
        <p>{tr.footer.desc}</p>
        <div class="socials">
          <a href="https://www.instagram.com/26.mh_studio/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@mh.studio_26" target="_blank" rel="noopener" aria-label="Tiktok">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tiktok" viewBox="0 0 16 16">
  <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3z"/>
</svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61590524406526" target="_blank" rel="noopener" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
  <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
</svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">{tr.footer.colServices}</div>
        {services.map(s => <a href={s.href}>{s.label}</a>)}
      </div>

      <div class="footer-col">
        <div class="footer-col-title">{tr.footer.colStudio}</div>
        <a href={localePath(locale, '/#work')}>{tr.footer.portfolio}</a>
        <a href={localePath(locale, '/#about')}>{tr.footer.about}</a>
        <a href={localePath(locale, '/#contact')}>{tr.footer.contact}</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">{locale === 'ar' ? 'اللغة' : locale === 'fr' ? 'Langue' : 'Language'}</div>
        {locales.map(l => (
          <a href={`/${l}/`} class={l === locale ? 'lang-footer-active' : ''} lang={l}>
            {localeLabels[l]}
          </a>
        ))}
      </div>
    </div>

    <div class="footer-bottom container">
      <span>{tr.footer.rights}</span>
      <span>{tr.footer.crafted}</span>
    </div>
  </footer>

</body>
</html>
<style is:global>
/* =========================================================
   ARABIC FONT
========================================================= */

:lang(ar),
:lang(ar) * {
  font-family: 'Noto Kufi Arabic', 'Syne', sans-serif !important;
}

:lang(ar) .logo,
:lang(ar) .logo em {
  font-family: 'Syne', sans-serif !important;
}


/* =========================================================
   RTL LAYOUT
========================================================= */

.rtl .nav-inner {
  flex-direction: row-reverse;
}

.rtl .nav-links {
  flex-direction: row-reverse;
}

.rtl .lang-switcher {
  flex-direction: row-reverse;
}

.rtl .footer-bottom {
  flex-direction: row-reverse;
}


/* =========================================================
   NAVIGATION — BASE
========================================================= */

#site-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;

  z-index: 200;

  padding: 24px 0;

  transition:
    background 0.3s ease,
    padding 0.3s ease,
    border-color 0.3s ease;
}

#site-nav.scrolled {
  background: rgba(8, 8, 15, 0.93);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  padding: 14px 0;

  border-bottom: 1px solid var(--border);
}


/* =========================================================
   NAV INNER
========================================================= */

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;

  position: relative;
}


/* =========================================================
   LOGO
========================================================= */

.logo {
  display: inline-flex;
  align-items: center;

  font-family: 'Syne', sans-serif !important;

  font-weight: 800;
  font-size: 1.25rem;

  text-decoration: none;

  color: var(--white);

  letter-spacing: -0.02em;

  flex-shrink: 0;

  position: relative;
  z-index: 210;
}

.logo img {
  display: block;

  max-width: 150px;
  height: auto;

  object-fit: contain;
}

.logo span {
  color: var(--purple);
}

.logo em {
  font-style: normal;

  color: var(--muted);

  font-weight: 400;

  font-size: 0.85em;

  margin-left: 1px;
}


/* =========================================================
   DESKTOP NAV LINKS
========================================================= */

.nav-links {
  display: flex;
  align-items: center;

  gap: 28px;
}

.nav-links > a {
  position: relative;

  font-size: 0.78rem;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  color: var(--muted);

  text-decoration: none;

  white-space: nowrap;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.nav-links > a:hover {
  color: var(--white);
}


/* Animated underline */

.nav-links > a::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -6px;

  width: 100%;
  height: 1px;

  background: var(--purple);

  transform: scaleX(0);

  transform-origin: left;

  transition: transform 0.25s ease;
}

.nav-links > a:hover::after {
  transform: scaleX(1);
}


/* =========================================================
   LANGUAGE SWITCHER
========================================================= */

.lang-switcher {
  display: flex;
  align-items: center;

  gap: 2px;

  background: rgba(147, 144, 223, 0.08);

  border: 1px solid var(--border);

  border-radius: 4px;

  padding: 3px;
}

.lang-btn {
  font-size: 0.68rem !important;

  letter-spacing: 0.04em !important;

  text-transform: none !important;

  padding: 5px 10px;

  border-radius: 2px;

  color: var(--muted) !important;

  text-decoration: none;

  white-space: nowrap;

  transition:
    background 0.2s ease,
    color 0.2s ease !important;
}

.lang-btn:hover {
  color: var(--white) !important;

  background: rgba(147, 144, 223, 0.12);
}

.lang-active {
  background: var(--purple) !important;

  color: var(--bg) !important;

  font-weight: 600 !important;
}

.lang-footer-active {
  color: var(--purple) !important;
}


/* =========================================================
   NAV CTA
========================================================= */

.nav-cta {
  background: var(--purple) !important;

  color: var(--bg) !important;

  padding: 10px 20px !important;

  font-weight: 500 !important;

  border-radius: 2px;

  text-decoration: none;

  white-space: nowrap;

  transition:
    background 0.2s ease,
    transform 0.2s ease !important;
}

.nav-cta:hover {
  background: var(--purple-light) !important;

  transform: translateY(-1px);
}


/* =========================================================
   BURGER
========================================================= */

.burger {
  display: none;

  position: relative;

  z-index: 210;

  width: 42px;
  height: 42px;

  padding: 9px;

  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 5px;

  background: transparent;

  border: 1px solid var(--border);

  border-radius: 4px;

  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease;
}

.burger:hover {
  background: rgba(147, 144, 223, 0.08);

  border-color: var(--purple);
}

.burger span {
  display: block;

  width: 20px;
  height: 2px;

  background: var(--white);

  border-radius: 2px;

  transform-origin: center;

  transition:
    transform 0.3s ease,
    opacity 0.2s ease,
    width 0.3s ease;
}


/* =========================================================
   BURGER → X
========================================================= */

.burger.active span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.burger.active span:nth-child(2) {
  opacity: 0;

  width: 0;
}

.burger.active span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}


/* =========================================================
   FOOTER
========================================================= */

footer {
  margin-top: 120px;

  border-top: 1px solid var(--border);

  padding-top: 80px;
}

.footer-inner {
  display: grid;

  grid-template-columns: 2fr 1fr 1fr 1fr;

  gap: 48px;

  padding-bottom: 60px;
}

.footer-brand .logo {
  display: inline-block;

  margin-bottom: 16px;
}

.footer-brand p {
  font-size: 0.85rem;

  line-height: 1.8;

  color: var(--muted);

  max-width: 260px;
}

.socials {
  margin-top: 20px;

  display: flex;

  gap: 12px;
}

.socials a {
  width: 36px;
  height: 36px;

  border: 1px solid var(--border);

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  color: var(--muted);

  text-decoration: none;

  transition:
    border-color 0.2s ease,
    color 0.2s ease;
}

.socials a:hover {
  border-color: var(--purple);

  color: var(--purple);
}

.socials svg {
  width: 16px;
  height: 16px;
}

.footer-col {
  display: flex;

  flex-direction: column;

  gap: 12px;
}

.footer-col-title {
  font-family: 'Syne', sans-serif;

  font-size: 0.7rem;

  letter-spacing: 0.18em;

  text-transform: uppercase;

  color: var(--white);

  margin-bottom: 4px;

  font-weight: 500;
}

.footer-col a {
  font-size: 0.85rem;

  color: var(--muted);

  text-decoration: none;

  transition: color 0.2s ease;

  width: fit-content;
}

.footer-col a:hover {
  color: var(--purple);
}

.footer-bottom {
  border-top: 1px solid var(--border);

  padding-top: 28px;

  padding-bottom: 40px;

  display: flex;

  justify-content: space-between;

  font-size: 0.75rem;

  color: var(--muted);
}


/* =========================================================
   RTL FOOTER
========================================================= */

.rtl .footer-brand p {
  direction: rtl;
}

.rtl .footer-col {
  align-items: flex-end;

  text-align: right;
}


/* =========================================================
   MOBILE NAVIGATION
========================================================= */

@media (max-width: 900px) {

  /* NAV */

  #site-nav {
    padding: 18px 0;
    /* Always show a background on mobile so content behind nav is hidden */
    background: rgba(8, 8, 15, 0.93);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  #site-nav.scrolled {
    padding: 12px 0;
  }


  /* BURGER — stays above the fullscreen overlay */

  .burger {
    display: flex;
    z-index: 210;
  }


  /* FULLSCREEN MOBILE MENU */

  .nav-links {
    position: fixed;

    inset: 0;

    z-index: 199;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;
    height: fit-content;

    gap: 30px;

    padding: 100px 24px 40px;

    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(147, 144, 223, 0.10),
        transparent 40%
      ),
      rgba(8, 8, 15, 0.98);

    backdrop-filter: blur(24px);

    -webkit-backdrop-filter: blur(24px);

    /* Hidden */

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform: translateY(-12px);

    transition:
      opacity 0.3s ease,
      visibility 0.3s ease,
      transform 0.3s ease;
  }

.rtl .nav-links {
  flex-direction: column;
}


  /* OPEN */

  .nav-links.open {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform: translateY(0);
  }


  /* MOBILE LINKS */

  .nav-links > a {
    font-size: clamp(1.05rem, 4vw, 1.35rem);

    letter-spacing: 0.12em;

    color: var(--muted);

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .nav-links > a:hover {
    color: var(--white);

    transform: translateX(4px);
  }

  .nav-links > a::after {
    bottom: -8px;
  }


  /* MOBILE LANGUAGE SWITCHER */

  .lang-switcher {
    margin-top: 8px;

    padding: 4px;
  }

  .lang-btn {
    font-size: 0.75rem !important;

    padding: 7px 13px;
  }


  /* MOBILE CTA */

  .nav-cta {
    margin-top: 8px;

    padding: 13px 28px !important;

    font-size: 0.85rem !important;

    letter-spacing: 0.12em !important;

    text-align: center;
  }


  /* FOOTER */

  .footer-inner {
    grid-template-columns: 1fr 1fr;

    gap: 36px;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  .footer-bottom {
    flex-direction: column;

    gap: 8px;
  }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

  #site-nav {
    padding: 15px 0;
  }

  #site-nav.scrolled {
    padding: 10px 0;
  }


  /* LOGO */

  .logo img {
    max-width: 130px;

    height: auto;
  }


  /* BURGER */

  .burger {
    width: 40px;

    height: 40px;
  }


  /* MENU */

  .nav-links {
    gap: 26px;

    padding-left: 20px;

    padding-right: 20px;
  }

  .nav-links > a {
    font-size: 1rem;
  }

.rtl .nav-links {
  flex-direction: column;
}

  /* CTA */

  .nav-cta {
    width: min(220px, 80vw);
  }


  /* FOOTER */

  .footer-inner {
    grid-template-columns: 1fr;
  }
}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media (max-width: 360px) {

  .logo img {
    max-width: 115px;
  }

  .burger {
    width: 38px;

    height: 38px;
  }

  .nav-links {
    gap: 22px;
  }

  .nav-links > a {
    font-size: 0.95rem;
  }
    .rtl .nav-links {
  flex-direction: column;
}


  .lang-btn {
    padding: 6px 10px;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  #site-nav,
  .nav-links,
  .burger,
  .burger span,
  .nav-links > a,
  .nav-links > a::after,
  .nav-cta {
    transition: none !important;
  }
}
</style>


<script>
  const nav      = document.getElementById('site-nav');
  const burger   = document.getElementById('burger');
  const navLinks = document.getElementById('nav-links');

  // ── Scroll: only update when menu is closed ──────────────
  function updateScrolled() {
    if (navLinks?.classList.contains('open')) return; // don't fight the open menu
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  }
  window.addEventListener('scroll', updateScrolled, { passive: true });

  // ── Menu helpers ─────────────────────────────────────────
  const closeMenu = () => {
    burger?.classList.remove('active');
    navLinks?.classList.remove('open');
    document.body.style.overflow = '';
    burger?.setAttribute('aria-expanded', 'false');

    // Re-apply scroll state now that menu is closed
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  };

  const openMenu = () => {
    burger?.classList.add('active');
    navLinks?.classList.add('open');
    document.body.style.overflow = 'hidden';
    burger?.setAttribute('aria-expanded', 'true');

    // Always show solid nav background while menu is open
    nav?.classList.add('scrolled');
  };

  burger?.addEventListener('click', () => {
    navLinks?.classList.contains('open') ? closeMenu() : openMenu();
  });

  // Close on nav link click
  navLinks?.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  // Close on Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close + reset on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900) closeMenu();
  });

  // Run once on load so the nav is correct if user lands mid-page
  updateScrolled();
</script>
