---
/**
 * WorkGrid.astro — Clean video grid, no iframes, no embeds
 *
 * HOW TO ADD A NEW VIDEO:
 * 1. Drop your .mp4 file into src/assets/work-videos/
 * 2. Run `npm run thumbnails` (or it runs automatically on build)
 * 3. Add an entry to the `items` array below — match the filename
 *    (without extension) and link it to the Instagram post URL
 *
 * Clicking any card opens the Instagram post in a new tab.
 * No iframe, no embed.js, no Instagram script ever loads.
 */

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;

const labels = {
  ar: { play: 'تشغيل على إنستقرام', seeAll: 'عرض الكل على إنستقرام ↗' },
  en: { play: 'Watch on Instagram', seeAll: 'See all on Instagram ↗' },
  fr: { play: 'Voir sur Instagram', seeAll: 'Voir tout sur Instagram ↗' },
};
const l = labels[locale as keyof typeof labels] ?? labels.en;

// ─────────────────────────────────────────────────────────────
// ✏️  EDIT THIS — map each video filename (no extension) to its
// Instagram post URL and a category label.
// Thumbnail is auto-resolved from /work-thumbnails/<filename>.jpg
// ─────────────────────────────────────────────────────────────
const items = [
  { file: 'dz', url: 'https://www.instagram.com/p/DZ8S2RkohCm/', cat: 'AI Product Video' },
  { file: 'prima', url: 'https://www.instagram.com/p/DY9yGdwoPx6/', cat: 'AI Product Video' },
  { file: 'mahboul', url: 'https://www.instagram.com/p/DZXg45_EefC/', cat: 'AI Product Video' },
  { file: 'mahboul-box', url: 'https://www.instagram.com/p/DaBYiF7gG3t/', cat: 'AI Product Video' },
  { file: 'moon', url: 'https://www.instagram.com/p/DZaGA9WDDb_/', cat: 'AI Product Video' },
  { file: 'taghit', url: 'https://www.instagram.com/p/DV897uwiIFd/', cat: 'Social Media Post' },
  { file: 'ormina-parfum', url: 'https://www.instagram.com/p/DYPHNG2IULv/', cat: 'AI Product Video' },
  { file: 'explorea', url: 'https://www.instagram.com/p/DXt6i1MiAAl/', cat: 'Brand Identity' },
];
---

<div class="wg-wrap">
  <div class="wg-grid">
    {items.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener"
        class="wg-card"
        aria-label={l.play}
      >
        <img
          src={`/work-thumbnails/${item.file}.jpg`}
          alt={item.cat}
          loading="lazy"
          class="wg-thumb"
        />

        <div class="wg-overlay">
          <span class="wg-cat">{item.cat}</span>
          <span class="wg-play-label">{l.play}</span>
        </div>

        <div class="wg-play-btn">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </a>
    ))}
  </div>

  <div class="wg-footer">
    <a href="https://www.instagram.com/26.mh_studio/" target="_blank" rel="noopener" class="wg-see-all">
      {l.seeAll}
    </a>
  </div>
</div>

<style>
.wg-wrap { width: 100%; }

.wg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  background: var(--border);
}

.wg-card {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  display: block;
  text-decoration: none;
  background: var(--bg-card);
}

.wg-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease, filter 0.4s ease;
  filter: saturate(0.92) brightness(0.92);
}
.wg-card:hover .wg-thumb {
  transform: scale(1.05);
  filter: saturate(1) brightness(0.7);
}

/* ── Center play button ── */
.wg-play-btn {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.85);
  width: 52px; height: 52px;
  border-radius: 50%;
  background: rgba(147,144,223,0.9);
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease, transform 0.3s ease;
  backdrop-filter: blur(4px);
}
.wg-card:hover .wg-play-btn {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}
.wg-play-btn svg {
  width: 20px; height: 20px;
  color: var(--bg);
  margin-left: 2px;
}

/* ── Bottom overlay with category + label ── */
.wg-overlay {
  position: absolute;
  inset: auto 0 0 0;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: linear-gradient(to top, rgba(8,8,15,0.85) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.wg-card:hover .wg-overlay { opacity: 1; }

.wg-cat {
  font-size: 0.65rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--purple);
  font-weight: 600;
}
.wg-play-label {
  font-size: 0.78rem;
  color: var(--white);
  font-family: 'Syne', sans-serif;
  font-weight: 600;
}

/* ── Footer link ── */
.wg-footer {
  padding: 28px 0 0;
  display: flex;
  justify-content: flex-end;
}
.wg-see-all {
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  padding-bottom: 3px;
  transition: color 0.2s, border-color 0.2s;
}
.wg-see-all:hover { color: var(--purple); border-color: var(--purple); }

/* ── Responsive ── */
@media (max-width: 768px) {
  .wg-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .wg-grid { grid-template-columns: 1fr; }
}
</style>
